@@ -0,0 +1,39 @@
+import json
+import os
+from typing import Any
+
+from src.callbacks.callback import Callback, CallbackArguments
+
+
+class UsageLoggingCallback(Callback):
+    """
+    Appends one line per LLM call to usage.jsonl in the state directory, keyed by sample_index. It only reads, so it
+    does not change what the agent sees or does.
+    """
+
+    @classmethod
+    def is_unique(cls) -> bool:
+        return True
+
+    def on_agent_inference(self, callback_args: CallbackArguments) -> None:
+        agent: Any = callback_args.session_context.agent
+        language_model = getattr(agent, "_language_model", None)
+        usage_record_list = getattr(language_model, "usage_record_list", None)
+        if not usage_record_list:
+            return
+        session = callback_args.current_session
+        saving_path = os.path.join(self.get_state_dir(), "usage.jsonl")
+        with open(saving_path, "a", encoding="utf-8") as f:
+            for usage_record in usage_record_list:
+                f.write(
+                    json.dumps(
+                        {
+                            "sample_index": session.sample_index,
+                            "chat_history_length": session.chat_history.get_value_length(),
+                            "sample_status": str(session.sample_status),
+                            **usage_record,
+                        }
+                    )
+                    + "\n"
+                )
+        usage_record_list.clear()
